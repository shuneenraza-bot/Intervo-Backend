# Copy to .env and fill in. Never commit .env.

# Replace YOUR_PASSWORD with the postgres user's password.
# If it contains special characters (@ : / # % ?), URL-encode them, e.g. @ -> %40
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/intervo

# Long random string (32+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional. Tests default to DATABASE_URL with the database name replaced by "intervo_test".
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/intervo_test
