# Copy to .env and fill in. Never commit .env.

# Replace YOUR_PASSWORD with the postgres user's password.
# If it contains special characters (@ : / # % ?), URL-encode them, e.g. @ -> %40
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/intervo

# Long random string (32+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

JWT_EXPIRE_MINUTES=1440

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional. Tests default to DATABASE_URL with the database name replaced by "intervo_test".
# TEST_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/intervo_test

# --- AI provider layer (CV analysis) ---
# "gemini" uses Google Gemini and falls back to the rule-based parser if it fails; "rules" never calls AI.
AI_PROVIDER=gemini
# Get a key at https://aistudio.google.com/apikey. Leave empty to always use the rule-based parser.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_TIMEOUT_SECONDS=20

# --- Speech-to-text (Whisper via Groq) ---
# "groq" transcribes spoken answers; "none" returns 503 so the frontend uses browser speech recognition.
STT_PROVIDER=none
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
WHISPER_MODEL=whisper-large-v3-turbo
STT_TIMEOUT_SECONDS=30

# Where original CV files are saved (default: storage/ in the project folder)
# STORAGE_DIR=
